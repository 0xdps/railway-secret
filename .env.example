# Copy this file to .env.local for local development (docker compose / just dev)
# Copy this file to .env.prod  for running the published image locally (just run-prod)
# Railway injects these as real environment variables — no .env file needed in production.

# ─────────────────────────────────────────────
# Railway API Configuration
# ─────────────────────────────────────────────

# Your Railway API token, used to authenticate all GraphQL requests.
# Accepts a Personal Access Token (Bearer) or a Project Token (starts with "pt_").
# Generate one at: https://railway.app/account/tokens
RAILWAY_TOKEN=

# The ID of the Railway project whose secrets this tool manages.
# When deployed on Railway, this is injected automatically as RAILWAY_PROJECT_ID.
# Find it in your project's Settings → General tab, or via the Railway CLI.
RAILWAY_PROJECT_ID=

# The ID of the specific environment (e.g. production, staging) within the project.
# When deployed on Railway, this is injected automatically as RAILWAY_ENVIRONMENT_ID.
# Find it in your project's Settings → Environments tab.
RAILWAY_ENVIRONMENT_ID=

# ─────────────────────────────────────────────
# Admin Dashboard Authentication
# ─────────────────────────────────────────────

# Password required to log into the web dashboard.
# Use a strong, unique string — this is the only gate protecting the UI.
ADMIN_KEY=admin_password_here

# Secret used to encrypt and HMAC-sign the session cookie (AES-256-GCM).
# Must be kept private. Changing it will invalidate all active sessions.
# Generate with: openssl rand -hex 32
SESSION_SECRET=a_random_unbreakable_string_here

# ─────────────────────────────────────────────
# Database (mesahub)
# ─────────────────────────────────────────────

# Connection string for the mesahub SQLite-over-HTTP database.
# Embedded mode (database runs inside this container, data stored in /data):
#   MESAHUB_URL=mh://local/railway_secrets
# External mode (point to a self-hosted or cloud mesahub instance):
#   MESAHUB_URL=mh://your_api_key@your-mesahub.railway.app/railway_secrets
MESAHUB_URL=mh://local/railway_secrets

# ─────────────────────────────────────────────
# Encryption at Rest
# ─────────────────────────────────────────────

# Key used to encrypt secret history stored in mesahub (AES-256-GCM).
# CRITICAL: If you lose or change this key, all previously stored rotation history
# becomes unreadable and rollback will be impossible.
# Generate with: openssl rand -hex 32
MASTER_KEY=another_random_unbreakable_string_here

# ─────────────────────────────────────────────
# Cron / Rotation Behaviour
# ─────────────────────────────────────────────

# Set to true to run the rotation cron in dry-run mode.
# The cron will evaluate which secrets are due and log what WOULD be rotated
# but will make zero changes to Railway. Useful for diagnosing unexpected
# rotation triggers without risking live secrets.
# Valid values: true / false   (default: false)
DRY_RUN=false
 